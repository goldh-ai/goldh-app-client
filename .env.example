# goldh-app-client — Environment Variables
# =========================================
# Copy this file to .env and fill in the values provided by the GOLDH team.
#
# SECURITY: All values here are public, client-safe variables baked into the
# JS bundle. Never add server secrets, DB credentials, or API ingestion keys.

# ─── Server Connection ────────────────────────────────────────────────────────
# URL of the GOLDH dev server. Provided by the GOLDH team.
VITE_API_BASE_URL=https://goldh-gcp-dev.web.app

# ─── Firebase (Dev Project Only) ─────────────────────────────────────────────
# These are DEV Firebase credentials — never production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Set to 'true' to use mock/fixture data when dev server is unavailable.
# VITE_MOCK=true
